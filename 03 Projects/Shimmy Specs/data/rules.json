    {
      "section": "06 10 53",
      "when": {
        "any": [
          "construction-type-IIIA",
          "construction-type-IIIB",
          "construction-type-IV",
          "construction-type-VA",
          "construction-type-VB"
        ]
      },
      "level": "likely",
      "why": "Combustible framing allowed; blocking and nailers are common."
    },
    {
      "section": "06 10 53",
      "when": {
        "any": [
          "construction-type-IA",
          "construction-type-IB",
          "construction-type-IIA",
          "construction-type-IIB"
        ]
      },
      "level": "consider",
      "why": "Noncombustible type: keep only where blocking or nailers are in scope (fire-retardant-treated where required)."
    },
    {
      "section": "06 10 00",
      "when": {
        "any": [
          "construction-type-IIIA",
          "construction-type-IIIB",
          "construction-type-VA",
          "construction-type-VB"
        ]
      },
